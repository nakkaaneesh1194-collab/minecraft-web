# Register a confidential web app in Microsoft Entra ID. Redirect URI must exactly match this value.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Generate at least 32 random bytes; used only to sign HttpOnly OAuth/session cookies.
AUTH_SESSION_SECRET=
