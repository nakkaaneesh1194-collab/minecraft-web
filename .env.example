# Copy this file to apps/web/.env.local. Next.js is started from apps/web; .env.local is ignored by Git; never commit it.
# Microsoft Entra app registration → Overview → Application (client) ID (a GUID).
MICROSOFT_CLIENT_ID=
# Microsoft Entra app registration → Certificates & secrets → create a client secret.
# Store the secret VALUE, never its Secret ID.
MICROSOFT_CLIENT_SECRET=
# Authority selection: consumers for personal Microsoft accounts (recommended for Minecraft);
# common for personal + work/school accounts; or your directory (tenant) GUID for one organization.
MICROSOFT_TENANT_ID=consumers
# Microsoft Entra app registration → Authentication → Web redirect URI. This must exactly match.
# Local browser development:
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Generate locally, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This is only for signing HttpOnly cookies; it is not a Microsoft credential.
AUTH_SESSION_SECRET=
